`timescale 1ns / 1ps

module wb_ram_tb;

    // Parameters
    parameter DW = 32;
    parameter DEPTH = 1024;
    parameter AW = 32;

    // Signalsa
    reg wb_clk_i = 0;
    reg wb_rst_i;
    reg [AW-1:0] wb_adr_i;
    reg [DW-1:0] wb_dat_i;
    reg [3:0]    wb_sel_i;
    reg          wb_we_i;
    reg [1:0]    wb_bte_i;
    reg [2:0]    wb_cti_i;
    reg          wb_cyc_i;
    reg          wb_stb_i;

    wire         wb_ack_o;
    wire         wb_err_o;
    wire [DW-1:0] wb_dat_o;

    // Clock generation (100MHz)
    always #5 wb_clk_i = ~wb_clk_i;

    // DUT (Device Under Test) Instance
    wb_ram #(
        .dw(DW),
        .depth(DEPTH)
    ) dut (
        .wb_clk_i(wb_clk_i),
        .wb_rst_i(wb_rst_i),
        .wb_adr_i(wb_adr_i),
        .wb_dat_i(wb_dat_i),
        .wb_sel_i(wb_sel_i),
        .wb_we_i(wb_we_i),
        .wb_bte_i(wb_bte_i),
        .wb_cti_i(wb_cti_i),
        .wb_cyc_i(wb_cyc_i),
        .wb_stb_i(wb_stb_i),
        .wb_ack_o(wb_ack_o),
        .wb_err_o(wb_err_o),
        .wb_dat_o(wb_dat_o)
    );

    // Task to write a 32-bit word (Byte Addressing)
    task wb_write(input [AW-1:0] addr, input [DW-1:0] data);
    begin
        @(posedge wb_clk_i);
        wb_adr_i <= addr;
        wb_dat_i <= data;
        wb_sel_i <= 4'b1111; // Ghi cả 4 byte
        wb_we_i  <= 1'b1;
        wb_cyc_i <= 1'b1;
        wb_stb_i <= 1'b1;
        wb_cti_i <= 3'b000; // Classic cycle
        
        // Chờ phản hồi ACK
        wait(wb_ack_o);
        @(posedge wb_clk_i);
        wb_cyc_i <= 1'b0;
        wb_stb_i <= 1'b0;
        wb_we_i  <= 1'b0;
        $display("WRITE: Addr=0x%b, Data=0x%h", addr, data);
    end
    endtask

    // Task to read a 32-bit word (Byte Addressing)
    task wb_read(input [AW-1:0] addr);
    begin
        @(posedge wb_clk_i);
        wb_adr_i <= addr;
        wb_sel_i <= 4'b1111;
        wb_we_i  <= 1'b0;
        wb_cyc_i <= 1'b1;
        wb_stb_i <= 1'b1;
        wb_cti_i <= 3'b000;

        wait(wb_ack_o);
        @(posedge wb_clk_i);
        $display("READ:  Addr=0x%b, Data=0x%h", addr, wb_dat_o);
        wb_cyc_i <= 1'b0;
        wb_stb_i <= 1'b0;
    end
    endtask

    // Stimulus
    initial begin
        // Initialize signals
        wb_rst_i = 1;
        wb_adr_i = 0;
        wb_dat_i = 0;
        wb_sel_i = 0;
        wb_we_i  = 0;
        wb_bte_i = 0;
        wb_cti_i = 0;
        wb_cyc_i = 0;
        wb_stb_i = 0;

        #20 wb_rst_i = 0;
        #10;

        // Test ghi vào các địa chỉ Byte
        // Lưu ý: adr_r[aw-1:2] sẽ lấy 0, 1, 2...
        wb_write(32'h00000000, 32'hDEADBEEF); // Word 0
        wb_write(32'h00000404, 32'hCAFEBABE); // Word 1
        wb_write(32'h10000008, 32'h12345678); // Word 2

        #20;

        // Test đọc lại
        wb_read(32'h00000000);
        wb_read(32'h00000404);
        wb_read(32'h10000008);

        #50;
        $display("Testbench finished!");
        $stop;
    end

endmodule
